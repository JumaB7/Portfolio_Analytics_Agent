# Copy to .env and fill in values. Never commit .env.

APP_NAME=Portfolio Analytics Agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Comma-separated Angular origin(s)
CORS_ORIGINS=http://localhost:4200

# LLM provider (server-side only — never expose to the browser)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Synthetic SQL Server demo database (read-only connection recommended)
# Example: mssql+pyodbc://user:pass@localhost\\SQLEXPRESS/AnalyticsDemo?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=
