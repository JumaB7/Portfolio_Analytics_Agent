# Copy to .env and fill in values. Never commit .env.

APP_NAME=Portfolio Analytics Agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Comma-separated Angular origin(s)
CORS_ORIGINS=http://localhost:4200

# LLM provider (server-side only — never expose to the browser)
# OpenAI-compatible Chat Completions API
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
AGENT_MAX_TOOL_ITERATIONS=4

# Synthetic SQL Server demo database (read-only connection recommended in deployment).
# Leave empty to use LocalDB default: (localdb)\MSSQLLocalDB / AnalyticsDemo
# DATABASE_URL=
