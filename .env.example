# Copy to .env and fill in values. Never commit .env.

APP_NAME=Portfolio Analytics Agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Comma-separated Angular origin(s) — include both host spellings
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# LLM provider (server-side only — never expose to the browser)
# OpenAI-compatible Chat Completions API
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
AGENT_MAX_TOOL_ITERATIONS=4
# true = skip second LLM call; answer from tool JSON templates
AGENT_TEMPLATE_ANSWERS=true
# true = route common demo prompts without calling the LLM
AGENT_RULE_ROUTER=true

# Shared portfolio analytics dataset (same endpoint the dashboard uses).
# Leave empty to use the built-in local seed fallback.
PORTFOLIO_API_BASE_URL=http://127.0.0.1:5157
PORTFOLIO_API_TIMEOUT_SECONDS=5

# Legacy LocalDB e-commerce seed (unused by portfolio tools).
# DATABASE_URL=
